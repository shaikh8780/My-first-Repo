aws_account_id             = "<account-id>"
aws_region                 = "us-east-1"
domain_name                = "esg-studio.<your-domain>"
parent_zone_name           = "<your-domain>"
certificate_domain         = "*.<your-domain>"
vpc_id                     = "vpc-<id>"
private_subnet_name_filter = "<private-subnet-name>-*"
public_subnet_name_filter  = "<public-subnet-name>-*"
cognito_user_pool_id       = "<region>_<id>"
cognito_domain             = "<prefix>.auth.<region>.amazoncognito.com"
bedrock_model_id           = "<model-id-enabled-in-the-account>"
